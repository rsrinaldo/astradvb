diff --git a/ecm-protection.h b/ecm-protection.h
new file mode 100644
--- /dev/null
+++ b/ecm-protection.h
@@ -0,0 +1,22 @@
+/* AstraDVB additions, GPL-2.0-or-later. */
+#ifndef ASTRA_ECM_PROTECTION_H
+#define ASTRA_ECM_PROTECTION_H
+#include <stdint.h>
+#include <time.h>
+struct ecm_policy { int64_t next_attempt_us; unsigned int failures; };
+static inline int64_t ecm_clock_us(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (int64_t)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+static inline int ecm_policy_ready(const struct ecm_policy *p, int64_t now, int64_t created) {
+    return created <= now && now - created <= 2000000 && now >= p->next_attempt_us;
+}
+static inline void ecm_policy_success(struct ecm_policy *p) { p->failures = 0; p->next_attempt_us = 0; }
+static inline void ecm_policy_failure(struct ecm_policy *p, int64_t now, unsigned int service) {
+    if (p->failures < 6) p->failures++;
+    int64_t seconds = (int64_t)1 << (p->failures - 1);
+    if (seconds > 30) seconds = 30;
+    p->next_attempt_us = now + seconds * 1000000 + (service % 251) * 1000;
+}
+#endif
