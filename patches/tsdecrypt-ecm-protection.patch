diff --git a/ecm-protection.h b/ecm-protection.h
new file mode 100644
--- /dev/null
+++ b/ecm-protection.h
@@ -0,0 +1,17 @@
+/* AstraDVB additions, GPL-2.0-or-later. */
+#ifndef ASTRA_ECM_PROTECTION_H
+#define ASTRA_ECM_PROTECTION_H
+#include <stdint.h>
+#include <time.h>
+/* Reject only obsolete queued work. Failed keys must not suppress a fresh
+ * changed ECM; aggregate provider admission belongs to the shared guard. */
+static inline int64_t ecm_clock_us(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (int64_t)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+static inline int ecm_work_fresh(int64_t now, int64_t created) {
+    return created <= now && now - created <= 2000000;
+}
+#define ASTRA_NATIVE_CAS_POLICY_VERSION 3
+#endif
