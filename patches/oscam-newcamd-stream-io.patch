diff --git a/astra-newcamd-io.h b/astra-newcamd-io.h
new file mode 100644
--- /dev/null
+++ b/astra-newcamd-io.h
@@ -0,0 +1,64 @@
+/* AstraDVB additions, GPL-3.0-or-later. */
+#ifndef ASTRA_NEWCAMD_IO_H
+#define ASTRA_NEWCAMD_IO_H
+#include <errno.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <time.h>
+#ifndef ASTRA_NEWCAMD_RECV
+#define ASTRA_NEWCAMD_RECV recv
+#endif
+#ifndef ASTRA_NEWCAMD_POLL
+#define ASTRA_NEWCAMD_POLL poll
+#endif
+static inline int64_t astra_newcamd_now_ms(void)
+{
+    struct timespec now;
+    if(clock_gettime(CLOCK_MONOTONIC, &now) < 0) { return -1; }
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+/* Preserve the existing socket receive timeout, but apply it to the whole
+ * read rather than restarting it for each fragment or interrupted syscall.
+ * OSCam sets SO_RCVTIMEO to 600s. The same cap bounds an unlimited socket;
+ * this also allows the guard to delay admission without login retry loops. */
+static inline ssize_t astra_newcamd_read_exact(int fd, void *buffer, size_t length)
+{
+    struct timeval timeout;
+    socklen_t timeout_size = sizeof(timeout);
+    if(length > SSIZE_MAX || (!buffer && length)) { errno = EINVAL; return -1; }
+    if(!length) { return 0; }
+    if(getsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, &timeout_size) < 0) { return -1; }
+    if(timeout.tv_sec < 0 || timeout.tv_usec < 0 || timeout.tv_usec >= 1000000) { errno = EINVAL; return -1; }
+    int64_t budget = timeout.tv_sec >= 600 ? 600000 : (int64_t)timeout.tv_sec * 1000 + (timeout.tv_usec + 999) / 1000;
+    if(!budget) { budget = 600000; }
+    int64_t started = astra_newcamd_now_ms();
+    if(started < 0) { return -1; }
+    int64_t deadline = started + budget;
+    size_t received = 0;
+    while(received < length)
+    {
+        int64_t now = astra_newcamd_now_ms();
+        if(now < 0) { return received ? (ssize_t)received : -1; }
+        if(now >= deadline) { errno = EAGAIN; return received ? (ssize_t)received : -1; }
+        struct pollfd event = { .fd = fd, .events = POLLIN, .revents = 0 };
+        int ready = ASTRA_NEWCAMD_POLL(&event, 1, (int)(deadline - now));
+        if(ready < 0)
+        {
+            if(errno == EINTR) { continue; }
+            return received ? (ssize_t)received : -1;
+        }
+        if(!ready) { errno = EAGAIN; return received ? (ssize_t)received : -1; }
+        if(event.revents & POLLNVAL) { errno = EBADF; return received ? (ssize_t)received : -1; }
+        ssize_t count = ASTRA_NEWCAMD_RECV(fd, (uint8_t *)buffer + received, length - received, MSG_DONTWAIT);
+        if(count > 0) { received += (size_t)count; continue; }
+        if(!count) { return (ssize_t)received; }
+        if(errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) { continue; }
+        return received ? (ssize_t)received : -1;
+    }
+    return (ssize_t)received;
+}
+#define ASTRA_OSCAM_STREAM_IO_POLICY_VERSION 1
+#endif
