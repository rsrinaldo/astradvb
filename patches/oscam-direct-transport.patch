+/* OS uptime matches the legacy durable budget's clock, including suspend. */
+static uint64_t astra_direct_uptime(void)
+{
+	struct timespec ts;
+	if(clock_gettime(CLOCK_BOOTTIME, &ts)) { return 0; }
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+static uint64_t astra_direct_wall(void)
+{
+	struct timespec ts;
+	if(clock_gettime(CLOCK_REALTIME, &ts)) { return 0; }
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+static struct astra_semantic_scheduler *astra_direct_context(struct s_reader *reader)
+{
+	return reader && reader->astra_direct == 1 && reader->client ? reader->client->astra_scheduler : NULL;
+}
+static void astra_direct_report(struct s_reader *reader, int force)
+{
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(!s) { return; }
+	uint64_t now = astra_direct_uptime();
+	if(!force && now < s->next_direct_report_ms) { return; }
+	s->next_direct_report_ms = now + 5000;
+	struct astra_provider_budget *b = &s->provider;
+	rdr_log(reader, "astra direct status: port=%u ready=%u connections=%"PRIu64" closes=%"PRIu64" frames=%"PRIu64" failures=%"PRIu64" retryMs=%"PRIu64" attempts=%"PRIu64" stableRecoveries=%"PRIu64,
+		(unsigned)reader->astra_report_port, (unsigned)b->ready, b->connections, b->closes, b->frames,
+		b->failures, astra_provider_delay(b, now), b->count, b->stable_recoveries);
+	rdr_log(reader, "astra health status: port=%u mode=%u limited=%u good=%"PRIu64" negative=%"PRIu64" late=%"PRIu64" entries=%"PRIu64" probes=%"PRIu64" recoveries=%"PRIu64" nextMs=%"PRIu64,
+		(unsigned)reader->astra_report_port, b->health_mode, b->health_limited,
+		b->health_good, b->health_negative, b->health_late, b->health_entries,
+		b->health_probe_sent, b->health_recoveries, b->health_next > now ? b->health_next - now : 0);
+}
+int astra_direct_admit(struct s_reader *reader)
+{
+	if(!reader || reader->astra_direct != 1) { return 1; }
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(!s) { return 0; } /* no unprotected early connect, even during init */
+	uint64_t now = astra_direct_uptime(), wall = astra_direct_wall();
+	if(!now || !wall || now < s->direct_open_retry_ms) { return 0; }
+	if(s->provider.dirfd < 0)
+	{
+		char boot[37] = {0};
+		int fd = open("/proc/sys/kernel/random/boot_id", O_RDONLY | O_CLOEXEC);
+		ssize_t length = fd >= 0 ? read(fd, boot, 36) : -1;
+		if(fd >= 0) { close(fd); }
+		if(length != 36 || !astra_provider_open(&s->provider, reader->astra_budget_directory, reader->astra_budget_account, boot, now, wall))
+			{ s->direct_open_retry_ms = now + 5000; return 0; }
+	}
+	astra_health_open(&s->provider, now);
+	s->provider.frame_interval_ms = reader->astra_frame_interval;
+	int allowed = astra_provider_reserve(&s->provider, now, wall);
+	astra_direct_report(reader, 0);
+	return allowed;
+}
+void astra_direct_failed(struct s_reader *reader)
+{
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(!s || !s->provider.attempted) { return; }
+	astra_provider_failed(&s->provider, astra_direct_uptime(), astra_direct_wall());
+	astra_direct_report(reader, 1);
+}
+void astra_direct_authenticated(struct s_reader *reader)
+{
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(!s) { return; }
+	s->provider.ready = 1;
+	astra_direct_report(reader, 1);
+}
+int astra_direct_frame(struct s_reader *reader)
+{
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(!s) { return reader && reader->astra_direct != 1; }
+	struct astra_provider_budget *b = &s->provider;
+	while(b->attempted && !reader->client->kill)
+	{
+		uint64_t now = astra_direct_uptime();
+		if(!astra_provider_owned(b)) { return 0; }
+		if(astra_provider_take_frame(b, now)) { return 1; }
+		uint64_t wait = b->next_frame > now ? b->next_frame - now : 1;
+		if(wait > 1000) { return 0; }
+		struct timespec pause = { .tv_sec = (time_t)(wait / 1000), .tv_nsec = (long)(wait % 1000) * 1000000 };
+		while(nanosleep(&pause, &pause) && errno == EINTR) { if(reader->client->kill) { return 0; } }
+	}
+	return 0;
+}
+void astra_direct_frame_complete(struct s_reader *reader)
+{
+	struct astra_semantic_scheduler *s = astra_direct_context(reader);
+	if(s && s->provider.attempted)
+		{ s->provider.next_frame = astra_direct_uptime() + reader->astra_frame_interval; }
+}
