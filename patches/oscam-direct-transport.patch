 #define ASTRA_OSCAM_STREAM_IO_POLICY_VERSION 1
+/* Direct WAN writes cannot assume send() accepts a complete framed message.
+ * Never resend a whole partial frame or let a stalled write block indefinitely. */
+#ifndef ASTRA_NEWCAMD_SEND
+#define ASTRA_NEWCAMD_SEND send
+#endif
+static inline ssize_t astra_newcamd_write_exact(int fd, const void *buffer, size_t length)
+{
+    if(length > SSIZE_MAX || (!buffer && length)) { errno = EINVAL; return -1; }
+    size_t written = 0;
+    int64_t now = astra_newcamd_now_ms();
+    if(now < 0) { return -1; }
+    int64_t deadline = now + 2000;
+    while(written < length)
+    {
+        now = astra_newcamd_now_ms();
+        if(now < 0 || now >= deadline) { errno = EAGAIN; return -1; }
+        ssize_t n = ASTRA_NEWCAMD_SEND(fd, (const uint8_t *)buffer + written, length - written, MSG_DONTWAIT | MSG_NOSIGNAL);
+        if(n > 0) { written += (size_t)n; continue; }
+        if(n < 0 && errno == EINTR) { continue; }
+        if(n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        {
+            struct pollfd event = { .fd = fd, .events = POLLOUT };
+            int ready = ASTRA_NEWCAMD_POLL(&event, 1, (int)(deadline - now));
+            if(ready < 0 && errno == EINTR) { continue; }
+            if(ready <= 0) { if(!ready) { errno = EAGAIN; } return -1; }
+            continue;
+        }
+        if(!n) { errno = EPIPE; }
+        return -1;
+    }
+    return (ssize_t)written;
+}
 #endif
