new file mode 100644
index 0000000..b628257
--- /dev/null
+++ b/astra-io.h
@@ -0,0 +1,39 @@
+/* AstraDVB additions, GPL-2.0-or-later. */
+#ifndef ASTRA_IO_H
+#define ASTRA_IO_H
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+#include <unistd.h>
+typedef ssize_t (*astra_read_fn)(int, void *, size_t);
+typedef ssize_t (*astra_write_fn)(int, const void *, size_t);
+/* Stream-oriented input does not preserve producer write boundaries. Keep a
+ * partial transport packet until a full fixed-size frame (or EOF) is read. */
+static inline ssize_t astra_read_ts_frame(int fd, uint8_t *data, size_t size,
+                                        astra_read_fn read_fn, const int *running) {
+    size_t used = 0;
+    while (used < size && *running) {
+        ssize_t n = read_fn(fd, data + used, size - used);
+        if (n > 0) { used += (size_t)n; continue; }
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0 && used == 0) return -1;
+        break;
+    }
+    /* A truncated final packet cannot be handed to the 188-byte decoder. */
+    return (ssize_t)(used - used % 188);
+}
+/* Only use for stream/file output, never split a UDP datagram. */
+static inline int astra_write_all(int fd, const uint8_t *data, size_t size,
+                                  astra_write_fn write_fn) {
+    size_t used = 0;
+    while (used < size) {
+        ssize_t n = write_fn(fd, data + used, size - used);
+        if (n > 0) { used += (size_t)n; continue; }
+        if (n < 0 && errno == EINTR) continue;
+        if (n == 0) errno = EIO;
+        return -1;
+    }
+    return 0;
+}
+#endif
