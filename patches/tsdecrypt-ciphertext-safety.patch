+}
+static inline int astra_ciphertext_batch(struct astra_ciphertext *s, astra_ct_batch_fn batch, unsigned int count) {
+    if (!batch || !count || count > ASTRA_CT_BATCH_PACKETS) return 0;
+    s->batch = batch; s->batch_size = count; return 1;
