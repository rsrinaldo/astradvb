+        s->pids[i].run = ASTRA_CT_NONE; s->pids[i].type = type; s->pids[i].ancillary = ancillary;
+    }
+    s->context = context; s->phase_seen = 0; s->candidate_blocked = 0;
+    s->word_revision[0]++; s->word_revision[1]++; s->transition_revision++;
+    s->candidate_revision[0]++; s->candidate_revision[1]++;
