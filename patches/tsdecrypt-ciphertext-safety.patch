+    uint64_t context_drops, prefix_drops, candidate_overflows, run_overflows, ambiguous_probes, ancillary_drops, orphan_drops;
+    uint64_t current_held_bytes, peak_held_bytes, allocated_bytes;
+};
+struct astra_ct_key {
