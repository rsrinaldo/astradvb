diff --git a/process.c b/process.c
index 0887e15..b124029 100644
--- a/process.c
+++ b/process.c
@@ -29,6 +29,137 @@ static unsigned long ts_pack;
 static int ts_pack_shown;
 extern int keep_running;
 
+static inline void output_write(struct ts *ts, uint8_t *data, unsigned int data_size);
+
+/* CAMD owns this bounded publication queue; decoder owns every retention/
+ * candidate object. No media write, allocation, or provider operation occurs
+ * under the cross-thread word-copy mutex. */
+void process_ciphertext_word(struct ts *ts, uint32_t context, const uint8_t words[16]) {
+	pthread_mutex_lock(&ts->ciphertext_words_lock);
+	if (ts->ciphertext_word_count == 64) {
+		ts->ciphertext_word_overflow = 1;
+		ts->ciphertext_word_count = 0;
+	}
+	struct ciphertext_word_event *event = &ts->ciphertext_words[ts->ciphertext_word_count++];
+	event->context = context; memcpy(event->words, words, 16);
+	pthread_mutex_unlock(&ts->ciphertext_words_lock);
+}
+static int ciphertext_schedule(struct ts *ts, const uint8_t word[8]) {
+	if (!ts->ciphertext_work_key) ts->ciphertext_work_key = csa_key_alloc();
+	if (!ts->ciphertext_work_key) return 0;
+	if (!ts->ciphertext_work_valid || memcmp(ts->ciphertext_work_word, word, 8)) {
+		uint8_t pair[16]; memcpy(pair, word, 8); memcpy(pair + 8, word, 8);
+		csa_set_cw(ts->ciphertext_work_key, pair, 0);
+		memcpy(ts->ciphertext_work_word, word, 8); ts->ciphertext_work_valid = 1;
+	}
+	return 1;
+}
+static int ciphertext_decrypt(void *opaque, const uint8_t word[8], const uint8_t in[188], uint8_t out[188]) {
+	struct ts *ts = opaque;
+	if (!ts->ciphertext_probe) ts->ciphertext_probe = astra_ciphertext_probe_alloc();
+	return astra_ciphertext_probe_decrypt(ts->ciphertext_probe, word, in, out);
+}
+static int ciphertext_decrypt_batch(void *opaque, const uint8_t word[8], const uint8_t (*in)[188], uint8_t (*out)[188], size_t count) {
+	struct ts *ts = opaque;
+	if (!ciphertext_schedule(ts, word) || count > ASTRA_CT_BATCH_PACKETS) return 0;
+	struct csa_batch packets[ASTRA_CT_BATCH_PACKETS + 1];
+	uint8_t *cluster[ASTRA_CT_BATCH_PACKETS * 2 + 1];
+	for (size_t i = 0; i < count; i++) {
+		memcpy(out[i], in[i], 188);
+		unsigned int offset = ts_packet_get_payload_offset(out[i]);
+		if (offset >= 188) return 0;
+		packets[i].data = out[i] + offset; packets[i].len = 188 - offset;
+		cluster[i * 2] = out[i]; cluster[i * 2 + 1] = out[i] + 188;
+	}
+	packets[count].data = NULL; cluster[count * 2] = NULL;
+	if (use_dvbcsa) {
+		/* Both temporary schedules contain this exact immutable half. */
+		csa_decrypt_multiple_even(ts->ciphertext_work_key, packets);
+		for (size_t i = 0; i < count; i++) ts_packet_set_not_scrambled(out[i]);
+	}
+	if (use_ffdecsa) csa_decrypt_multiple_ff(ts->ciphertext_work_key, cluster);
+	return 1;
+}
+static int ciphertext_emit(void *opaque, const uint8_t packet[188]) {
+	struct ts *ts = opaque;
+	if (!ts->threaded) { output_write(ts, (uint8_t *)packet, 188); return 1; }
+	while (!ts->write_stop && cbuf_fill(ts->write_buf, (void *)packet, 188) != 0) {
+		if (!keep_running) return 0;
+		usleep(1000);
+	}
+	return !ts->write_stop;
+}
+static int ciphertext_ensure(struct ts *ts) {
+	if (ts->ciphertext) return 1;
+	/* Reserve256KiB of the8MiB envelope for the bounded native word queue,
+	 * input sidecar metadata and cached output/scalar-probe CSA schedules. */
+	ts->ciphertext = astra_ciphertext_create(ASTRA_CT_MAX_BYTES - 262144, ASTRA_CT_MAX_WAIT_MS,
+		ciphertext_decrypt, ciphertext_emit, ts);
+	if (!ts->ciphertext || !astra_ciphertext_batch(ts->ciphertext, ciphertext_decrypt_batch, csa_get_batch_size())) {
+		ts_LOGf("CT | allocation failure, withholding media\n"); return 0;
+	}
+	return 1;
+}
+static void ciphertext_words(struct ts *ts, uint32_t context, uint64_t now) {
+	struct ciphertext_word_event events[64]; unsigned int count = 0, kept = 0; int overflow;
+	pthread_mutex_lock(&ts->ciphertext_words_lock);
+	overflow = ts->ciphertext_word_overflow; ts->ciphertext_word_overflow = 0;
+	for (unsigned int i = 0; i < ts->ciphertext_word_count; i++) {
+		struct ciphertext_word_event *event = &ts->ciphertext_words[i];
+		if (event->context == context) events[count++] = *event;
+		else if (event->context > context) ts->ciphertext_words[kept++] = *event;
+	}
+	ts->ciphertext_word_count = kept;
+	pthread_mutex_unlock(&ts->ciphertext_words_lock);
+	if (overflow) astra_ciphertext_invalidate(ts->ciphertext);
+	for (unsigned int i = 0; i < count; i++) {
+		astra_ciphertext_word(ts->ciphertext, context, 0, events[i].words, now);
+		astra_ciphertext_word(ts->ciphertext, context, 1, events[i].words + 8, now);
+	}
+}
+static void ciphertext_report(struct ts *ts, uint64_t now, int force) {
+	if (!ts->ciphertext || (!force && now - ts->ciphertext_report_ms < 5000)) return;
+	ts->ciphertext_report_ms = now;
+	struct astra_ct_stats *s = &ts->ciphertext->stats;
+	ts_LOGf("CT | heldBytes=%" PRIu64 " peakBytes=%" PRIu64 " dropped=%" PRIu64 " timeout=%" PRIu64 " capacity=%" PRIu64 " prefix=%" PRIu64 " recovered=%" PRIu64 " allocated=%" PRIu64 " ancillary=%" PRIu64 " orphan=%" PRIu64 "\n",
+		s->current_held_bytes, s->peak_held_bytes, s->packets_dropped, s->timeout_drops,
+		s->capacity_drops, s->prefix_drops, s->recovered_holds, s->allocated_bytes, s->ancillary_drops, s->orphan_drops);
+}
+static int ciphertext_slot(struct ts *ts, const struct ciphertext_slot *slot, uint64_t now) {
+	if (!ciphertext_ensure(ts)) return 0;
+	int changed = ts->ciphertext->context != slot->context;
+	if (changed) {
+		astra_ciphertext_context(ts->ciphertext, slot->context);
+		if (ts->camd.constant_codeword) {
+			astra_ciphertext_word(ts->ciphertext, slot->context, 0, ts->key.cw, now);
+			astra_ciphertext_word(ts->ciphertext, slot->context, 1, ts->key.cw + 8, now);
+		}
+	}
+	if (changed || !ts->threaded) ciphertext_words(ts, slot->context, now);
+	unsigned int pid = ts_packet_get_pid((uint8_t *)slot->data);
+	astra_ciphertext_pid(ts->ciphertext, pid, slot->type);
+	return !slot->allowed || astra_ciphertext_push(ts->ciphertext, slot->data, now);
+}
+static void ciphertext_batch(struct ts *ts, const uint8_t *data, int data_len) {
+	uint64_t now = ecm_clock_us() / 1000;
+	if (!ciphertext_ensure(ts)) { ts->decode_stop = 1; keep_running = 0; return; }
+	ciphertext_words(ts, ts->ciphertext->context, now);
+	astra_ciphertext_defer(ts->ciphertext, 1);
+	for (int at = 0; at + (int)sizeof(struct ciphertext_slot) <= data_len; at += sizeof(struct ciphertext_slot)) {
+		struct ciphertext_slot slot; memcpy(&slot, data + at, sizeof(slot));
+		if (!ciphertext_slot(ts, &slot, now)) { ts->decode_stop = 1; keep_running = 0; break; }
+	}
+	astra_ciphertext_defer(ts->ciphertext, 0);
+	if (!astra_ciphertext_pump(ts->ciphertext, now, 0)) { ts->decode_stop = 1; keep_running = 0; }
+	ciphertext_report(ts, now, 0);
+}
+void process_finish_ciphertext(struct ts *ts) {
+	if (!ts->ciphertext) return;
+	uint64_t now = ecm_clock_us() / 1000;
+	ciphertext_words(ts, ts->ciphertext->context, now);
+	astra_ciphertext_finish(ts->ciphertext, now); ciphertext_report(ts, now, 1);
+}
