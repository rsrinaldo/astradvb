+/* Native callers feed one existing CSA-sized input batch before pumping, so
+ * healthy traffic retains SIMD CSA batching instead of decrypting one packet
+ * per push. Deferral never bypasses the hard queue capacity. */
+static inline void astra_ciphertext_defer(struct astra_ciphertext *s, int deferred) { s->deferred = !!deferred; }
+static inline void astra_ct_drop_head(struct astra_ciphertext *s, unsigned int reason) {
+    struct astra_ct_packet *p = &s->queue[s->head];
+    s->stats.packets_dropped++;
+    if (reason == 1) s->stats.timeout_drops++;
+    if (reason == 2) s->stats.capacity_drops++;
+    if (reason == 3) s->stats.context_drops++;
+    if (reason == 4) s->stats.prefix_drops++;
+    if (reason == 6) s->stats.orphan_drops++;
+    astra_ct_run_release(s, p->run);
+    s->head = (s->head + 1) % s->capacity; s->count--;
+    if (!s->count) s->head = 0;
+    s->stats.current_held_bytes = s->count * sizeof(*p);
+}
+static inline void astra_ciphertext_destroy(struct astra_ciphertext *s) {
+    if (!s) return;
+    while (s->count) astra_ct_drop_head(s, 0);
+    for (unsigned int i = 0; i < ASTRA_CT_PID_COUNT; i++) astra_ct_run_release(s, s->pids[i].run);
+    memset(s->keys, 0, sizeof(s->keys)); free(s->queue); free(s);
+}
+static inline void astra_ciphertext_invalidate(struct astra_ciphertext *s) {
+    for (unsigned int i = 0; i < ASTRA_CT_RUN_COUNT; i++) if (s->runs[i].present) { s->runs[i].confirmed = 0; s->runs[i].failed = 3; }
+    for (unsigned int i = 0; i < ASTRA_CT_PID_COUNT; i++) {
+        astra_ct_run_release(s, s->pids[i].run); s->pids[i].run = ASTRA_CT_NONE; s->pids[i].seen = 0;
+    }
+    for (unsigned int i = 0; i < ASTRA_CT_KEY_COUNT; i++) {
+        if (s->keys[i].references) s->keys[i].context = UINT32_MAX;
+        else memset(&s->keys[i], 0, sizeof(s->keys[i]));
