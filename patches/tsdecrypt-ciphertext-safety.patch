+    if (!s) return NULL;
+    s->capacity = (max_bytes - sizeof(*s)) / sizeof(*s->queue);
+    s->queue = calloc(s->capacity, sizeof(*s->queue));
+    if (!s->queue) { free(s); return NULL; }
+    s->decrypt = decrypt; s->emit = emit; s->opaque = opaque; s->wait_ms = wait_ms;
+    s->stats.allocated_bytes = sizeof(*s) + s->capacity * sizeof(*s->queue);
+    for (unsigned int i = 0; i < ASTRA_CT_PID_COUNT; i++) s->pids[i].run = ASTRA_CT_NONE;
