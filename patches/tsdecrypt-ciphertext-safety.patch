+static inline void astra_ct_probe(struct astra_ciphertext *s, struct astra_ct_run *r, uint64_t now_ms) {
+    if (r->confirmed || r->failed || !r->anchor_count || (s->candidate_blocked & (1u << r->parity))) return;
+    if (now_ms - r->first_ms >= s->wait_ms) { r->failed = 1; return; }
+    /* A completed unchanged anchor does not gain evidence from another TS
+     * continuation. Keep UNKNOWN pins intact, but admit every genuinely new
+     * candidate and every new/split PES prefix. Expiry above is never cached. */
+    if (r->probe_cached && r->probe_anchor_revision == r->anchor_revision &&
+        r->probe_candidate_revision == s->candidate_revision[r->parity]) return;
+    r->probe_cached = 1; r->probe_anchor_revision = r->anchor_revision;
+    r->probe_candidate_revision = s->candidate_revision[r->parity];
+    uint16_t chosen = ASTRA_CT_NONE; unsigned int matches = 0, unknown = 0; uint64_t possible_mask = 0;
+    for (unsigned int i = 0; i < ASTRA_CT_KEY_COUNT; i++) {
+        struct astra_ct_key *k = &s->keys[i];
+        if (!k->present || k->parity != r->parity || k->context != r->context) continue;
+        if (r->ambiguous_mask && !(r->ambiguous_mask & (UINT64_C(1) << i))) continue;
+        uint8_t prefix[19]; size_t filled = 0; int usable = 1;
+        for (unsigned int a = 0; a < r->anchor_count && filled < sizeof(prefix); a++) {
+            struct astra_ct_packet *p = astra_ct_anchor_packet(s, r->anchor_slots[a]);
+            uint8_t clear[188];
+            if (!p || p->run_serial != r->serial || !s->decrypt(s->opaque, k->word, p->bytes, clear) || (clear[3] & 0xc0)) { usable = 0; break; }
+            unsigned int offset = astra_ct_offset(clear); size_t copy = 188 - offset;
+            if (copy > sizeof(prefix) - filled) copy = sizeof(prefix) - filled;
+            memcpy(prefix + filled, clear + offset, copy); filled += copy;
+        }
+        enum astra_pes_evidence result = usable ? astra_pes_header(prefix, filled, r->type) : ASTRA_PES_INVALID;
+        if (result == ASTRA_PES_VALID) { chosen = i; matches++; possible_mask |= UINT64_C(1) << i; }
+        if (result == ASTRA_PES_UNKNOWN) { unknown++; possible_mask |= UINT64_C(1) << i; }
+    }
+    /* Retention is not eligibility. Even with zero VALID candidates, every
+     * UNKNOWN word remains pinned so eviction cannot manufacture evidence.
+     * The all-UNKNOWN case does not latch ambiguous_mask: a genuinely late
+     * new word must still be considered. Exactly one reference per retained
+     * bit is released only by explicit exclusion, confirmation or run death. */
+    uint64_t excluded = r->retained_mask & ~possible_mask;
+    uint64_t added = possible_mask & ~r->retained_mask;
+    for (unsigned int i = 0; i < ASTRA_CT_KEY_COUNT; i++) {
+        if (excluded & (UINT64_C(1) << i)) astra_ct_key_release(s, i);
+        if (added & (UINT64_C(1) << i)) s->keys[i].references++;
+    }
+    r->retained_mask = possible_mask;
+    if (r->ambiguous_mask) {
+        r->ambiguous_mask &= possible_mask;
+        if (!possible_mask) { r->failed = 5; return; }
+    }
+    if (matches == 1 && !unknown) {
+        for (unsigned int i = 0; i < ASTRA_CT_KEY_COUNT; i++) if (r->retained_mask & (UINT64_C(1) << i)) astra_ct_key_release(s, i);
+        r->ambiguous_mask = 0; r->retained_mask = 0;
+        r->confirmed = 1; r->key = chosen; s->keys[chosen].references++;
+        if (r->had_hold) s->stats.recovered_holds++;
+    } else if (matches >= 1 && matches + unknown > 1 && !r->ambiguous_mask) {
+        s->stats.ambiguous_probes++; r->ambiguous_mask = possible_mask;
+    }
+}
+static inline int astra_ciphertext_pump(struct astra_ciphertext *s, uint64_t now_ms, int finishing) {
+    if (s->output_failed) return 0;
+    if (now_ms >= s->next_gc_ms) {
+        s->next_gc_ms = now_ms + (s->wait_ms < 1000 ? s->wait_ms : 1000);
+        /* A removed PMT component may never produce another packet. Release
+         * only its idle PID-owner reference; queued ciphertext still pins the
+         * immutable run/key until emission or fail-closed discard. Returning
+         * after this same silence threshold already requires reanchoring. */
+        for (unsigned int i = 0; i < ASTRA_CT_RUN_COUNT; i++) {
+            struct astra_ct_run *r = &s->runs[i];
+            if (!r->present) continue;
+            struct astra_ct_pid *p = &s->pids[r->pid];
+            if (p->run == i && p->seen && now_ms - p->seen_ms >= s->wait_ms) {
+                p->run = ASTRA_CT_NONE; p->seen = 0; astra_ct_run_release(s, i);
+            }
+        }
+    }
+    if (s->probe_dirty) {
+        s->probe_dirty = 0;
+        for (unsigned int i = 0; i < ASTRA_CT_RUN_COUNT; i++) if (s->runs[i].present) astra_ct_probe(s, &s->runs[i], now_ms);
+    }
+    while (s->count) {
+        struct astra_ct_packet *p = &s->queue[s->head];
+        struct astra_ct_run *r = p->run == ASTRA_CT_NONE ? NULL : &s->runs[p->run];
+        if (r && (!r->present || r->serial != p->run_serial)) { s->output_failed = 1; return 0; }
+        /* A replaced run with no PES anchor cannot gain one from future
+         * input: that PID now appends to a different run. More CWs cannot
+         * certify it. Retire only this unreachable ciphertext immediately;
+         * anchored or still-owned unknown runs retain ordinary late-key waits. */
+        if (r && !r->confirmed && !r->failed && !r->anchor_count &&
+            s->pids[r->pid].run != p->run) r->failed = 6;
+        if (r && !r->confirmed && !r->failed && !finishing && now_ms - p->received_ms < s->wait_ms) break;
+        if (r && !r->confirmed) {
+            unsigned int reason = r->failed ? r->failed : 1;
+            r->failed = reason; astra_ct_drop_head(s, reason); continue;
+        }
+        /* A later header cannot authenticate a same-parity prefix across a
+         * word/context/gap invalidation. Only a directly observed physical
+         * parity boundary permits retrospective release of continuation. */
+        if (r && !r->prefix_allowed && p->sequence < r->anchor_slots[0]) {
+            astra_ct_drop_head(s, 4); continue;
+        }
+        if (r && s->batch) {
+            unsigned int ready = 0;
+            /* Inspect only the existing SIMD-sized READY prefix. Clear PSI/
+             * audio/control slots must not fragment an immutable-key cohort,
+             * but no decrypt or output may look past uncertain ciphertext or
+             * a fail-closed discard boundary. */
+            while (ready < s->batch_size && ready < s->count) {
+                struct astra_ct_packet *item = &s->queue[(s->head + ready) % s->capacity];
+                if (item->run != ASTRA_CT_NONE) {
+                    struct astra_ct_run *run = &s->runs[item->run];
+                    if (!run->present || run->serial != item->run_serial) { s->output_failed = 1; return 0; }
+                    if (!run->confirmed || run->failed ||
+                        (!run->prefix_allowed && item->sequence < run->anchor_slots[0])) break;
+                }
+                ready++;
+            }
+            if (!ready) { s->output_failed = 1; return 0; }
+            uint8_t transformed[ASTRA_CT_BATCH_PACKETS] = {0};
+            uint8_t positions[ASTRA_CT_BATCH_PACKETS];
+            for (unsigned int start = 0; start < ready; start++) {
+                struct astra_ct_packet *first = &s->queue[(s->head + start) % s->capacity];
+                if (transformed[start] || first->run == ASTRA_CT_NONE) continue;
+                uint16_t key_id = s->runs[first->run].key; unsigned int count = 0;
+                for (unsigned int at = start; at < ready; at++) {
+                    struct astra_ct_packet *item = &s->queue[(s->head + at) % s->capacity];
+                    if (transformed[at] || item->run == ASTRA_CT_NONE || s->runs[item->run].key != key_id) continue;
+                    positions[count] = at; memcpy(s->batch_raw[count++], item->bytes, 188);
+                }
+                if (!count || !s->batch(s->opaque, s->keys[key_id].word, s->batch_raw, s->batch_clear, count)) {
+                    s->output_failed = 1; return 0;
+                }
+                for (unsigned int i = 0; i < count; i++) if (s->batch_clear[i][3] & 0xc0) { s->output_failed = 1; return 0; }
+                /* Only certified queue entries are transformed. Once any raw
+                 * entry is overwritten, every later decrypt/emit failure is
+                 * sticky: mutated ciphertext can never be re-probed/retried. */
+                for (unsigned int i = 0; i < count; i++) {
+                    unsigned int at = positions[i]; transformed[at] = 1;
+                    memcpy(s->queue[(s->head + at) % s->capacity].bytes, s->batch_clear[i], 188);
+                }
+            }
+            for (unsigned int i = 0; i < ready; i++) {
+                p = &s->queue[s->head];
+                if (!s->emit(s->opaque, p->bytes)) { s->output_failed = 1; return 0; }
+                s->stats.packets_out++;
+                astra_ct_run_release(s, p->run);
+                s->head = (s->head + 1) % s->capacity; s->count--;
+            }
+            if (!s->count) s->head = 0;
+            s->stats.current_held_bytes = s->count * sizeof(*p); continue;
+        }
+        uint8_t clear[188]; const uint8_t *out = p->bytes;
+        if (r) {
+            if (!s->decrypt(s->opaque, s->keys[r->key].word, p->bytes, clear) || (clear[3] & 0xc0)) { r->failed = 1; r->confirmed = 0; continue; }
+            out = clear;
+        }
+        if (!s->emit(s->opaque, out)) { s->output_failed = 1; return 0; }
+        s->stats.packets_out++;
+        astra_ct_run_release(s, p->run);
+        s->head = (s->head + 1) % s->capacity; s->count--;
+        if (!s->count) s->head = 0;
+        s->stats.current_held_bytes = s->count * sizeof(*p);
+    }
+    return !s->output_failed;
+}
+static inline int astra_ciphertext_push(struct astra_ciphertext *s, const uint8_t packet[188], uint64_t now_ms) {
+    if (s->output_failed || !packet || packet[0] != 0x47 || (!s->deferred && !astra_ciphertext_pump(s, now_ms, 0))) return 0;
+    while (s->count == s->capacity) {
+        struct astra_ct_packet *head = &s->queue[s->head];
+        if (head->run != ASTRA_CT_NONE) { s->runs[head->run].confirmed = 0; s->runs[head->run].failed = 2; }
+        astra_ct_drop_head(s, 2);
+        if (!astra_ciphertext_pump(s, now_ms, 0)) return 0;
+    }
+    unsigned int pid = ((unsigned int)(packet[1] & 31) << 8) | packet[2];
+    unsigned int tsc = packet[3] >> 6, parity = tsc & 1, offset = astra_ct_offset(packet);
+    struct astra_ct_pid *p = &s->pids[pid]; uint16_t id = ASTRA_CT_NONE;
+    unsigned int control = (packet[3] >> 4) & 3;
+    if (p->type && ((packet[1] & 0x80) || tsc == 1 || control == 0 ||
+        ((control == 2 || control == 3) && packet[4] > 183))) {
+        astra_ct_run_release(s, p->run); p->run = ASTRA_CT_NONE; p->seen = 0;
+        s->stats.packets_in++; s->stats.packets_dropped++; return 1;
+    }
+    if (p->type && tsc > 1 && offset < 188 && !(packet[1] & 0x80)) {
+        /* Sparse private PES is not an A/V phase clock. An unanchored tail
+         * must neither block the FIFO nor invalidate another PID's run. */
+        if (!p->ancillary && p->seen && parity != p->parity && (!s->phase_seen || s->phase != parity)) {
+            s->phase_seen = 1; s->phase = parity; s->transition_revision++;
+        }
+        if (!p->ancillary && !s->phase_seen) { s->phase_seen = 1; s->phase = parity; }
+        unsigned int cc = packet[3] & 15;
+        int discontinuity = ((packet[3] & 0x20) && packet[4] && (packet[5] & 0x80));
+        /* A future half can be published while old same-parity media is
+         * still queued. It is a candidate, not a physical key boundary.
+         * Preserve an already certified continuous run until its own TSC/
+         * context boundary or next PUSI; that PUSI independently reprobes. */
+        /* Native SIMD batching defers pumping. Validate newly available PES
+         * evidence before a matching reply is mistaken for a word boundary.
+         * This changes no FIFO/decryption emission or expiry rule. */
+        if (s->probe_dirty && p->run != ASTRA_CT_NONE)
+            astra_ct_probe(s, &s->runs[p->run], now_ms);
+        /* A headerless raw prefix has no certificate to invalidate: a late
+         * candidate must remain eligible for its first future PES anchor.
+         * Preserve physical-parity prefix eligibility, but never relax a
+         * context, CC-gap, silence, phase or anchored-run invalidation. */
+        int word_split = p->word_revision != s->word_revision[parity] &&
+            (p->run == ASTRA_CT_NONE || (!s->runs[p->run].confirmed && s->runs[p->run].anchor_count));
+        /* One other-PID switch to the opposite parity is overlap, not an
+         * observed whole cycle on this still-certified continuous PID.
+         * Two transitions, a same-phase return or any own boundary reanchor. */
+        int phase_split = p->transition_revision != s->transition_revision;
+        if (phase_split && s->transition_revision - p->transition_revision == 1 &&
+            s->phase != parity && p->seen && p->parity == parity &&
+            p->run != ASTRA_CT_NONE && s->runs[p->run].confirmed && !s->runs[p->run].failed)
+            phase_split = 0;
+        int split = !p->seen || p->run == ASTRA_CT_NONE || parity != p->parity || discontinuity ||
+            now_ms - p->seen_ms >= s->wait_ms || word_split ||
+            phase_split || (cc != p->cc && cc != ((p->cc + 1) & 15));
+        if (!split && s->runs[p->run].failed) split = 1;
+        if (!split && !s->runs[p->run].confirmed && now_ms - s->runs[p->run].first_ms >= s->wait_ms) split = 1;
+        if (!split && (packet[1] & 0x40) && s->runs[p->run].confirmed) split = 1;
+        if (split) {
+            int prefix_allowed = p->seen && parity != p->parity && !discontinuity &&
+                now_ms - p->seen_ms < s->wait_ms && (cc == p->cc || cc == ((p->cc + 1) & 15));
+            astra_ct_new_run(s, pid, parity, prefix_allowed, now_ms);
+        }
+        id = p->run;
+        p->seen = 1; p->parity = parity; p->cc = cc; p->seen_ms = now_ms;
+        p->word_revision = s->word_revision[parity]; p->transition_revision = s->transition_revision;
+    } else if (p->type && tsc > 1) {
+        /* Never send a malformed/TEI encrypted selected packet as clear. */
+        s->stats.packets_in++; s->stats.packets_dropped++; return 1;
+    } else if (p->type && offset < 188 && p->seen) {
+        /* Short clear continuations carry no encrypted block and are not a
+         * key boundary. Keep raw ownership/CC, but never refresh the last
+         * encrypted timestamp or inherit across a PUSI/gap/discontinuity.
+         * Incomplete encrypted PES anchors keep the old fail-closed path. */
+        unsigned int cc = packet[3] & 15;
+        int discontinuity = ((packet[3] & 0x20) && packet[4] && (packet[5] & 0x80));
+        struct astra_ct_run *r = p->run == ASTRA_CT_NONE ? NULL : &s->runs[p->run];
+        if (188 - offset < 8 && !(packet[1] & 0x40) && !discontinuity && r && !r->failed &&
+            (r->confirmed || !r->anchor_count || r->anchor_complete) &&
+            now_ms - p->seen_ms < s->wait_ms && (cc == p->cc || cc == ((p->cc + 1) & 15))) p->cc = cc;
+        else { astra_ct_run_release(s, p->run); p->run = ASTRA_CT_NONE; p->seen = 0; }
+    }
+    /* A private-PES continuation without an anchor cannot be validated by
+     * waiting for more keys. Do not admit it to the shared ordered FIFO.
+     * Keep the bounded run owner so a later PUSI can recover normally. Once
+     * an anchor has begun, including a split prefix, ordinary bounded key
+     * validation/recovery remains unchanged. Never emit uncertain bytes. */
+    if (id != ASTRA_CT_NONE && p->ancillary && !(packet[1] & 0x40) &&
+        !s->runs[id].confirmed && !s->runs[id].anchor_count) {
+        s->stats.packets_in++; s->stats.packets_dropped++;
+        s->stats.ancillary_drops++; return 1;
+    }
+    struct astra_ct_packet *q = &s->queue[(s->head + s->count) % s->capacity];
+    memcpy(q->bytes, packet, 188); q->run = id; q->run_serial = id == ASTRA_CT_NONE ? 0 : s->runs[id].serial;
+    q->sequence = ++s->sequence; q->received_ms = now_ms; s->count++; s->stats.packets_in++;
+    s->stats.current_held_bytes = s->count * sizeof(*q);
+    if (s->stats.current_held_bytes > s->stats.peak_held_bytes) s->stats.peak_held_bytes = s->stats.current_held_bytes;
+    if (id != ASTRA_CT_NONE) {
+        struct astra_ct_run *r = &s->runs[id]; r->references++;
+        if (packet[1] & 0x40) { r->anchor_count = 0; r->anchor_bytes = 0; r->anchor_complete = 0; r->anchor_cc = packet[3] & 15; r->anchor_revision++; }
+        if (((packet[1] & 0x40) || (r->anchor_count && (packet[3] & 15) != r->anchor_cc)) && !r->anchor_complete && r->anchor_count < 19) {
+            unsigned int copy = 188 - offset;
+            if (copy > 19u - r->anchor_bytes) copy = 19u - r->anchor_bytes;
+            r->anchor_slots[r->anchor_count++] = q->sequence; r->anchor_bytes += copy;
+            r->anchor_revision++;
+            r->anchor_cc = packet[3] & 15; r->anchor_complete = r->anchor_bytes == 19;
+        }
+        astra_ct_probe(s, r, now_ms);
+        if (!r->confirmed) { r->had_hold = 1; s->stats.held_packets++; }
+    } else if (p->type && tsc > 1) {
+        /* Run exhaustion is fail-closed, not an untagged clear-packet path. */
+        s->count--; s->sequence--; s->stats.current_held_bytes = s->count * sizeof(*q); s->stats.packets_dropped++;
+    }
+    return s->deferred ? 1 : astra_ciphertext_pump(s, now_ms, 0);
+}
+static inline int astra_ciphertext_finish(struct astra_ciphertext *s, uint64_t now_ms) {
+    return astra_ciphertext_pump(s, now_ms, 1);
+}
+#endif
