+/* Normal native decoder safety (policy 11). READY-prefix SIMD cohorts preserve
+ * original TS order and adaptive retention bounds without fixed input delay.
+ * Copyright AstraDVB contributors, GPL-2.0-only.
+ *
+ * A PES anchor is syntax evidence, not CSA authentication. Retrospective
+ * continuation release requires an unchanged physical CW within the observed
+ * same-parity run. An unannounced same-parity key boundary is not provable from
+ * a TS continuation. Never infer CSA parity from an ECM table identifier.
+ */
+#ifndef ASTRA_CIPHERTEXT_SAFETY_H
+#define ASTRA_CIPHERTEXT_SAFETY_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include "astra-pes-validation.h"
+
+#define ASTRA_CT_KEY_COUNT 64
+#define ASTRA_CT_RUN_COUNT 256
+#define ASTRA_CT_PID_COUNT 8192
+#define ASTRA_CT_NONE UINT16_MAX
+#define ASTRA_CT_MAX_BYTES (8u * 1024u * 1024u)
+#define ASTRA_CT_MAX_WAIT_MS 5000u
+#define ASTRA_CT_BATCH_PACKETS 70u
+#define ASTRA_CT_PRIVATE_ANCILLARY 0x86u /* internal marker; never an on-wire stream type */
+
+/* Type 0x06 alone is NOT ancillary: AC-3 and other private audio use it.
+ * Only a complete, well-formed DVB subtitle/teletext descriptor list opts in.
+ * Audio/registration/extension or malformed metadata keeps legacy behavior. */
+static inline int astra_ct_ancillary_descriptors(const uint8_t *data, size_t size) {
+    int ancillary = 0;
+    if (!data || !size) return 0;
+    while (size) {
+        if (size < 2 || data[1] > size - 2) return 0;
+        unsigned int tag = data[0], length = data[1];
+        if (tag == 0x05 || tag == 0x6a || tag == 0x7a || tag == 0x7b || tag == 0x7c || tag == 0x7f) return 0;
+        if (tag == 0x59) { if (!length || length % 8) return 0; ancillary = 1; }
+        if (tag == 0x56) { if (!length || length % 5) return 0; ancillary = 1; }
+        data += 2 + length; size -= 2 + length;
+    }
+    return ancillary;
+}
+
+/* This helper is used at the ECM call site only. section_data_len includes
+ * all three bytes omitted by the pinned library's section_length comparison. */
+static inline int astra_ciphertext_same_ecm(const uint8_t *a, size_t a_length, const uint8_t *b, size_t b_length) {
+    return a && b && a_length && a_length == b_length && !memcmp(a, b, a_length);
+}
