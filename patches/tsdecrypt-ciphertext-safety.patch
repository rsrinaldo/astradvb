+static inline unsigned int astra_ct_offset(const uint8_t *p) {
+    unsigned int control = (p[3] >> 4) & 3;
+    if (control != 1 && control != 3) return 188;
+    unsigned int offset = control == 3 ? 5u + p[4] : 4u;
+    return offset < 188 ? offset : 188;
+}
+static inline void astra_ct_key_release(struct astra_ciphertext *s, uint16_t id) {
+    if (id != ASTRA_CT_NONE && s->keys[id].references) s->keys[id].references--;
+}
+static inline void astra_ct_run_release(struct astra_ciphertext *s, uint16_t id) {
+    if (id == ASTRA_CT_NONE) return;
+    struct astra_ct_run *r = &s->runs[id];
+    if (!r->references || --r->references) return;
+    astra_ct_key_release(s, r->key);
+    for (unsigned int i = 0; i < ASTRA_CT_KEY_COUNT; i++) if (r->retained_mask & (UINT64_C(1) << i)) astra_ct_key_release(s, i);
+    memset(r, 0, sizeof(*r));
+}
+static inline struct astra_ciphertext *astra_ciphertext_create(size_t max_bytes, unsigned int wait_ms,
+        astra_ct_decrypt_fn decrypt, astra_ct_emit_fn emit, void *opaque) {
+    if (!decrypt || !emit || !wait_ms || wait_ms > ASTRA_CT_MAX_WAIT_MS ||
+        max_bytes > ASTRA_CT_MAX_BYTES || max_bytes < sizeof(struct astra_ciphertext) + 32 * sizeof(struct astra_ct_packet)) return NULL;
