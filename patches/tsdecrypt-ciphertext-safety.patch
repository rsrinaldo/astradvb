+/* Private single-packet PES probes; no FFdecsa/global backend selection. */
+#ifndef ASTRA_CIPHERTEXT_PROBE_H
+#define ASTRA_CIPHERTEXT_PROBE_H
+#include <stdint.h>
+struct astra_ciphertext_probe;
+struct astra_ciphertext_probe *astra_ciphertext_probe_alloc(void);
+void astra_ciphertext_probe_free(struct astra_ciphertext_probe **probe);
+int astra_ciphertext_probe_decrypt(struct astra_ciphertext_probe *probe,
+    const uint8_t word[8], const uint8_t in[188], uint8_t out[188]);
+#endif
diff --git a/astra-ciphertext-probe.c b/astra-ciphertext-probe.c
new file mode 100644
index 0000000..45414db
--- /dev/null
+++ b/astra-ciphertext-probe.c
@@ -0,0 +1,41 @@
+/* AstraDVB contributors, GPL-2.0-only.
+ * This separate TU deliberately never includes native csa.h. Enabling both
+ * native backend macros would run both decryptors and corrupt media. */
+#include <stdlib.h>
+#include <string.h>
+#include <dvbcsa/dvbcsa.h>
+#include "astra-ciphertext-probe.h"
+
+struct astra_ciphertext_probe {
+    dvbcsa_key_t *key;
+    uint8_t word[8];
+    int valid;
+};
+struct astra_ciphertext_probe *astra_ciphertext_probe_alloc(void) {
+    struct astra_ciphertext_probe *probe = calloc(1, sizeof(*probe));
+    if (!probe) return NULL;
+    probe->key = dvbcsa_key_alloc();
+    if (!probe->key) { free(probe); return NULL; }
+    return probe;
+}
+void astra_ciphertext_probe_free(struct astra_ciphertext_probe **pointer) {
+    if (!pointer || !*pointer) return;
+    struct astra_ciphertext_probe *probe = *pointer;
+    dvbcsa_key_free(probe->key);
+    memset(probe, 0, sizeof(*probe)); free(probe); *pointer = NULL;
+}
+int astra_ciphertext_probe_decrypt(struct astra_ciphertext_probe *probe,
+        const uint8_t word[8], const uint8_t in[188], uint8_t out[188]) {
+    if (!probe || !word || !in || !out || in[0] != 0x47 || (in[1] & 0x80) || (in[3] >> 6) < 2) return 0;
+    unsigned int control = (in[3] >> 4) & 3;
+    if (control != 1 && control != 3) return 0;
+    unsigned int offset = control == 3 ? 5u + in[4] : 4u;
+    if (offset >= 188) return 0;
+    if (!probe->valid || memcmp(probe->word, word, 8)) {
+        dvbcsa_key_set(word, probe->key); memcpy(probe->word, word, 8); probe->valid = 1;
+    }
+    memcpy(out, in, 188);
+    dvbcsa_decrypt(probe->key, out + offset, 188 - offset);
+    out[3] &= 0x3f;
+    return 1;
+}
