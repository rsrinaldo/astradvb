diff --git a/astra-pes-validation.h b/astra-pes-validation.h
new file mode 100644
index 0000000..ca1bbf8
--- /dev/null
+++ b/astra-pes-validation.h
@@ -0,0 +1,138 @@
+/* AstraDVB, GPL-2.0-only. PES evidence is not a wall-clock timeout. */
+#ifndef ASTRA_PES_VALIDATION_H
+#define ASTRA_PES_VALIDATION_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <pthread.h>
+
+#define ASTRA_PES_PID_COUNT 8192
+enum astra_pes_evidence { ASTRA_PES_UNKNOWN = 0, ASTRA_PES_VALID = 1, ASTRA_PES_INVALID = 2 };
+struct astra_pes_validation {
+    pthread_mutex_t lock;
+    uint8_t expected[ASTRA_PES_PID_COUNT];
+    uint8_t previous[ASTRA_PES_PID_COUNT];
+    uint8_t validated[ASTRA_PES_PID_COUNT];
+    uint8_t invalid[ASTRA_PES_PID_COUNT];
+    unsigned int invalid_count;
+    int configured;
+    /* Only the bounded prefix needed for PES/PTS/DTS validation, not media. */
+    struct { uint8_t bytes[19], filled, active, cc; } probe[ASTRA_PES_PID_COUNT];
+};
+
+static inline int astra_pes_stream_type(uint8_t type) {
+    switch (type) {
+    case 0x01: case 0x02: case 0x03: case 0x04: case 0x06:
+    case 0x0f: case 0x10: case 0x11: case 0x12: case 0x15:
+    case 0x1b: case 0x24: case 0x42: case 0x81: case 0x87:
+        return 1;
+    default: return 0; /* Private PSI, DSM-CC and unknown formats are not PES. */
+    }
+}
+static inline int astra_pes_stream_id(uint8_t type, uint8_t id) {
+    switch (type) {
+    case 0x01: case 0x02: case 0x10: case 0x1b: case 0x24: case 0x42:
+        return (id >= 0xe0 && id <= 0xef) || id == 0xfd;
+    case 0x03: case 0x04: case 0x0f: case 0x11: case 0x81: case 0x87:
+        return (id >= 0xc0 && id <= 0xdf) || id == 0xbd || id == 0xfd;
+    case 0x06: return id == 0xbd || id == 0xfd;
+    case 0x12: return id == 0xfa || id == 0xbd;
+    case 0x15: return id == 0xfc || id == 0xbd;
+    default: return 0;
+    }
+}
+static inline void astra_pes_init(struct astra_pes_validation *state) {
+    memset(state, 0, sizeof(*state)); pthread_mutex_init(&state->lock, NULL);
+}
+static inline void astra_pes_destroy(struct astra_pes_validation *state) { pthread_mutex_destroy(&state->lock); }
+/* Input thread publishes PMT membership under this lock. The writer never
+ * dereferences PMT objects that the input thread may replace/free. */
+static inline void astra_pes_update_begin(struct astra_pes_validation *state) {
+    pthread_mutex_lock(&state->lock); memcpy(state->previous, state->expected, sizeof(state->expected));
+    memset(state->expected, 0, sizeof(state->expected));
+    memset(state->probe, 0, sizeof(state->probe));
+}
+static inline void astra_pes_update_pid(struct astra_pes_validation *state, uint16_t pid, uint8_t type) {
+    if (pid < ASTRA_PES_PID_COUNT && astra_pes_stream_type(type)) state->expected[pid] = type;
+}
+static inline void astra_pes_update_end(struct astra_pes_validation *state) {
+    for (unsigned int pid = 0; pid < ASTRA_PES_PID_COUNT; pid++) {
+        if (state->expected[pid] != state->previous[pid]) state->validated[pid] = 0;
+        if ((!state->expected[pid] || state->expected[pid] != state->previous[pid]) && state->invalid[pid]) {
+            state->invalid[pid] = 0; state->invalid_count--;
+        }
+    }
+    state->configured = 1;
+    pthread_mutex_unlock(&state->lock);
+}
+static inline int astra_pes_timestamp(const uint8_t *p, unsigned int prefix) {
+    return (p[0] & 0xf1) == ((prefix << 4) | 1) && (p[2] & 1) && (p[4] & 1);
+}
+static inline enum astra_pes_evidence astra_pes_header(const uint8_t *p, size_t size, uint8_t type) {
+    if (!type || !size) return ASTRA_PES_UNKNOWN;
+    if (p[0] || (size >= 2 && p[1]) || (size >= 3 && p[2] != 1) ||
+        (size >= 4 && !astra_pes_stream_id(type, p[3])) ||
+        (size >= 7 && (p[6] & 0xc0) != 0x80)) return ASTRA_PES_INVALID;
+    if (size < 9) return ASTRA_PES_UNKNOWN;
+    unsigned int flags = p[7] >> 6;
+    unsigned int optional = p[8];
+    unsigned int required = flags == 3 ? 10 : flags == 2 ? 5 : 0;
+    if (flags == 1 || optional < required) return ASTRA_PES_INVALID;
+    unsigned int length = ((unsigned int)p[4] << 8) | p[5];
+    if (length && length < 3 + optional) return ASTRA_PES_INVALID;
+    if (9 + required > size) return ASTRA_PES_UNKNOWN;
+    if (flags && !astra_pes_timestamp(p + 9, flags == 3 ? 3 : 2)) return ASTRA_PES_INVALID;
+    if (flags == 3 && !astra_pes_timestamp(p + 14, 1)) return ASTRA_PES_INVALID;
+    return ASTRA_PES_VALID;
+}
+static inline enum astra_pes_evidence astra_pes_probe(struct astra_pes_validation *state,
+                                                     const uint8_t *packet, unsigned int pid, uint8_t type) {
+    if ((packet[1] & 0x80) || (packet[3] & 0xc0)) { state->probe[pid].active = 0; return ASTRA_PES_INVALID; }
+    unsigned int control = (packet[3] >> 4) & 3;
+    unsigned int offset = control == 3 ? 5 + packet[4] : 4;
+    if (offset >= 188) return ASTRA_PES_UNKNOWN;
+    unsigned int cc = packet[3] & 15;
+    if (packet[1] & 0x40) { state->probe[pid].active = 1; state->probe[pid].filled = 0; }
+    else if (!state->probe[pid].active) return ASTRA_PES_UNKNOWN;
+    else if (cc == state->probe[pid].cc) return ASTRA_PES_UNKNOWN;
+    else if (cc != ((state->probe[pid].cc + 1) & 15)) { state->probe[pid].active = 0; return ASTRA_PES_UNKNOWN; }
+    state->probe[pid].cc = cc;
+    size_t copy = 19 - state->probe[pid].filled;
+    if (copy > 188 - offset) copy = 188 - offset;
+    memcpy(state->probe[pid].bytes + state->probe[pid].filled, packet + offset, copy);
+    state->probe[pid].filled += copy;
+    enum astra_pes_evidence result = astra_pes_header(state->probe[pid].bytes, state->probe[pid].filled, type);
+    if (result != ASTRA_PES_UNKNOWN) state->probe[pid].active = 0;
+    return result;
+}
+/* Any explicit invalid selected PES wins a mixed frame. Valid audio cannot
+ * clear invalid video: each damaged PID needs its own valid PES to recover.
+ * UNKNOWN after validation is ordinary continuation, never encryption proof. */
+static inline unsigned int astra_pes_frame(struct astra_pes_validation *state, const uint8_t *data,
+                                          size_t length, int require_initial_pes, int *blocked) {
+    unsigned int evidence = ASTRA_PES_UNKNOWN; int unknown_selected = 0;
+    pthread_mutex_lock(&state->lock);
+    for (size_t at = 0; at + 188 <= length; at += 188) {
+        const uint8_t *packet = data + at;
+        unsigned int pid = ((unsigned int)(packet[1] & 31) << 8) | packet[2];
+        uint8_t type = state->expected[pid];
+        if (!type) continue;
+        unsigned int control = (packet[3] >> 4) & 3;
+        if (packet[0] != 0x47 || (control != 1 && control != 3)) continue;
+        enum astra_pes_evidence result = astra_pes_probe(state, packet, pid, type);
+        evidence |= result;
+        if (result == ASTRA_PES_INVALID && !state->invalid[pid]) { state->invalid[pid] = 1; state->invalid_count++; }
+        if (result == ASTRA_PES_VALID) {
+            state->validated[pid] = 1;
+            if (state->invalid[pid]) { state->invalid[pid] = 0; state->invalid_count--; }
+        }
+        /* A later valid header cannot retroactively authenticate earlier
+         * continuation bytes from this PID in the same writer frame. */
+        if (!state->validated[pid]) unknown_selected = 1;
+    }
+    *blocked = (evidence & ASTRA_PES_INVALID) || state->invalid_count ||
+        (require_initial_pes && (!state->configured || unknown_selected));
+    pthread_mutex_unlock(&state->lock);
+    return evidence;
+}
+#endif
