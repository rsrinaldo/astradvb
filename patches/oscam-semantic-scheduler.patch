diff --git a/astra-semantic-scheduler.h b/astra-semantic-scheduler.h
new file mode 100644
index 0000000..ab1486a
--- /dev/null
+++ b/astra-semantic-scheduler.h
@@ -0,0 +1,254 @@
+#ifndef ASTRA_SEMANTIC_SCHEDULER_H
+#define ASTRA_SEMANTIC_SCHEDULER_H
+
+/* Opt-in guarded-reader policy. No ECM, key or parent pointers live here.
+ * Caller owns the existing ecmtask[] storage and serializes these operations.
+ * Expired SENT slots retain their IDs until reply/transport closure. Only a
+ * deadline plus absence of matched complete ECM reply progress permits reset. */
+#include <stdint.h>
+#include <stddef.h>
+#define ASTRA_OSCAM_SEMANTIC_POLICY_VERSION 2
+
+enum astra_semantic_state { ASTRA_EMPTY, ASTRA_QUEUED, ASTRA_SENT, ASTRA_ALIAS };
+struct astra_semantic_slot
+{
+	uint64_t deadline_ms, order, service, sent_at_ms;
+	uint16_t id;
+	uint8_t state;
+};
+struct astra_semantic_core
+{
+	struct astra_semantic_slot *slots;
+	size_t capacity;
+	uint64_t sequence, next_send_ms, last_service;
+	uint32_t sent, peak_sent;
+	uint64_t dispatched, coalesced, expired, rejected;
+	uint16_t last_id;
+	uint8_t reply_progress;
+	uint64_t last_reply_ms, matched, generation, resets, abandoned, closes;
+	uint64_t soft_defer_until_ms;
+	uint8_t last_reset_reason;
+};
+
+static inline void astra_semantic_init(struct astra_semantic_core *q, struct astra_semantic_slot *slots, size_t capacity)
+{
+	*q = (struct astra_semantic_core){ .slots = slots, .capacity = capacity, .generation = 1 };
+	for(size_t i = 0; i < capacity; ++i) { slots[i] = (struct astra_semantic_slot){0}; }
+}
+
+static inline int astra_semantic_enqueue(struct astra_semantic_core *q, uint64_t now, uint64_t deadline, uint64_t service, int alias)
+{
+	if(deadline <= now) { q->expired++; return -1; }
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		if(q->slots[i].state != ASTRA_EMPTY) { continue; }
+		q->slots[i] = (struct astra_semantic_slot){ .deadline_ms = deadline, .order = ++q->sequence,
+			.service = service, .state = alias ? ASTRA_ALIAS : ASTRA_QUEUED };
+		if(alias) { q->coalesced++; }
+		return (int)i;
+	}
+	q->rejected++;
+	return -1;
+}
+
+static inline void astra_semantic_release(struct astra_semantic_core *q, size_t i)
+{
+	if(q->slots[i].state == ASTRA_SENT) { q->sent--; }
+	q->slots[i] = (struct astra_semantic_slot){0};
+}
+
+static inline int astra_semantic_expired(struct astra_semantic_core *q, uint64_t now)
+{
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		uint8_t state = q->slots[i].state;
+		if((state == ASTRA_QUEUED || state == ASTRA_ALIAS) && q->slots[i].deadline_ms <= now)
+			{ return (int)i; }
+	}
+	return -1;
+}
+
+static inline int astra_semantic_pick(struct astra_semantic_core *q, uint64_t now, int ready)
+{
+	if(!ready || q->sent >= 32 || now < q->next_send_ms) { return -1; }
+	int first = -1, other = -1, urgent = -1;
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		struct astra_semantic_slot *s = &q->slots[i];
+		if(s->state != ASTRA_QUEUED || s->deadline_ms <= now) { continue; }
+		int head = 1;
+		for(size_t j = 0; j < q->capacity; ++j)
+			{ if(q->slots[j].state == ASTRA_QUEUED && q->slots[j].service == s->service && q->slots[j].order < s->order) { head = 0; break; } }
+		if(!head) { continue; } /* never reorder fresh epochs within a service */
+		if(first < 0 || s->order < q->slots[first].order) { first = (int)i; }
+		if(s->service != q->last_service && (other < 0 || s->order < q->slots[other].order)) { other = (int)i; }
+		if(s->deadline_ms - now <= 1000 && (urgent < 0 || s->deadline_ms < q->slots[urgent].deadline_ms)) { urgent = (int)i; }
+	}
+	return urgent >= 0 ? urgent : other >= 0 ? other : first;
+}
+
+/* IDs are allocated only at actual dispatch. Never reuse a retained SENT ID,
+ * including after wrap or a client deadline. ID zero is reserved by Newcamd. */
+static inline uint16_t astra_semantic_next_id(struct astra_semantic_core *q, uint16_t previous)
+{
+	/* Keep the sender sequence independent of other protocol commands. Pinned
+	 * Newcamd CLIENT receive does not itself assign/rewind ncd_msgid. */
+	uint16_t candidate = q->dispatched ? q->last_id : previous;
+	for(uint32_t attempt = 0; attempt < 65535; ++attempt)
+	{
+		if(++candidate == 0) { candidate = 1; }
+		int used = 0;
+		for(size_t i = 0; i < q->capacity; ++i)
+			{ if(q->slots[i].state == ASTRA_SENT && q->slots[i].id == candidate) { used = 1; break; } }
+		if(!used) { return candidate; }
+	}
+	return 0;
+}
+
+static inline void astra_semantic_dispatch(struct astra_semantic_core *q, size_t i, uint64_t now, uint16_t id)
+{
+	q->slots[i].state = ASTRA_SENT;
+	q->slots[i].id = id;
+	q->slots[i].sent_at_ms = now;
+	q->last_id = id;
+	q->last_service = q->slots[i].service;
+	q->next_send_ms = now + 50; /* no accumulated credit / catch-up burst */
+	q->sent++;
+	if(q->sent > q->peak_sent) { q->peak_sent = q->sent; }
+	q->dispatched++;
+}
+
+/* Invoke ONLY after the worker parsed a complete ECM reply and matched its
+ * ID to this current transport's retained SENT slot. Cache, malformed data,
+ * arbitrary bytes, keepalive and send failure must never establish progress.
+ * Valid NOK and late matched replies still prove transport responsiveness. */
+static inline int astra_semantic_note_reply(struct astra_semantic_core *q, size_t i, uint16_t id, uint64_t now)
+{
+	if(i >= q->capacity || !id || q->slots[i].state != ASTRA_SENT || q->slots[i].id != id) { return 0; }
+	q->reply_progress = 1;
+	q->last_reply_ms = now;
+	q->matched++;
+	q->soft_defer_until_ms = 0;
+	return 1;
+}
+
+static inline uint64_t astra_semantic_no_progress_due(struct astra_semantic_core *q, uint64_t interval_ms)
+{
+	uint64_t oldest = UINT64_MAX;
+	for(size_t i = 0; i < q->capacity; ++i)
+		{ if(q->slots[i].state == ASTRA_SENT && q->slots[i].deadline_ms < oldest) { oldest = q->slots[i].deadline_ms; } }
+	if(oldest == UINT64_MAX) { return UINT64_MAX; }
+	if(q->reply_progress)
+	{
+		uint64_t progress = q->last_reply_ms > UINT64_MAX - interval_ms ? UINT64_MAX : q->last_reply_ms + interval_ms;
+		if(progress > oldest) { oldest = progress; }
+	}
+	return oldest;
+}
+
+/* Queue protection thresholds, NOT provider capacity/entitlement promises.
+ * Retire a whole generation, never reuse a live ID or replay individual work. */
+static inline uint64_t astra_semantic_recovery_due(struct astra_semantic_core *q, uint64_t interval_ms)
+{
+	uint64_t due = astra_semantic_no_progress_due(q, interval_ms);
+	uint64_t lifetime = interval_ms > UINT64_MAX / 4 ? UINT64_MAX : interval_ms * 4;
+	int demand = 0;
+	for(size_t i = 0; i < q->capacity; ++i) { if(q->slots[i].state == ASTRA_QUEUED) { demand = 1; break; } }
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		struct astra_semantic_slot *s = &q->slots[i];
+		if(s->state != ASTRA_SENT) { continue; }
+		uint64_t hard = s->sent_at_ms > UINT64_MAX - lifetime ? UINT64_MAX : s->sent_at_ms + lifetime;
+		if(hard < due) { due = hard; }
+		if(demand)
+		{
+			unsigned expired = 0;
+			for(size_t j = 0; j < q->capacity; ++j)
+				{ if(q->slots[j].state == ASTRA_SENT && q->slots[j].deadline_ms <= s->deadline_ms) { expired++; } }
+			if(expired >= 16 && s->deadline_ms < due) { due = s->deadline_ms; }
+		}
+	}
+	return due;
+}
+
+/* 1=no matched progress, 2=majority expired plus queued demand, 3=absolute
+ * orphan lifetime. Only soft rules give already-readable replies <=250ms to
+ * parse. Continuous junk cannot defeat this grace or the absolute lifetime. */
+static inline int astra_semantic_recovery_decision(struct astra_semantic_core *q, uint64_t now, uint64_t interval_ms, int readable)
+{
+	unsigned expired = 0;
+	int demand = 0, reason = 0;
+	uint64_t lifetime = interval_ms > UINT64_MAX / 4 ? UINT64_MAX : interval_ms * 4;
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		struct astra_semantic_slot *s = &q->slots[i];
+		if(s->state == ASTRA_QUEUED && s->deadline_ms > now) { demand = 1; }
+		if(s->state != ASTRA_SENT) { continue; }
+		if(s->deadline_ms <= now) { expired++; }
+		if(now >= s->sent_at_ms && now - s->sent_at_ms >= lifetime) { reason = 3; }
+	}
+	if(reason != 3)
+	{
+		uint64_t silence = astra_semantic_no_progress_due(q, interval_ms);
+		if(expired >= 16 && demand) { reason = 2; }
+		else if(silence != UINT64_MAX && now >= silence) { reason = 1; }
+	}
+	if(!reason) { q->soft_defer_until_ms = 0; return 0; }
+	if(reason != 3 && readable)
+	{
+		if(!q->soft_defer_until_ms) { q->soft_defer_until_ms = now > UINT64_MAX - 250 ? UINT64_MAX : now + 250; }
+		if(now < q->soft_defer_until_ms) { return 0; }
+	}
+	return reason;
+}
+
+static inline void astra_semantic_transport_closed(struct astra_semantic_core *q)
+{
+	q->abandoned += q->sent;
+	for(size_t i = 0; i < q->capacity; ++i) { astra_semantic_release(q, i); }
+	q->reply_progress = 0;
+	q->last_reply_ms = 0;
+	q->soft_defer_until_ms = 0;
+	q->generation++;
+	q->closes++;
+	/* Preserve sender sequence and frame deadline: closure gives no burst credit. */
+}
+
+static inline int astra_semantic_recovery_wait(struct astra_semantic_core *q, uint64_t now, uint64_t interval_ms, int normal_ms)
+{
+	uint64_t due = astra_semantic_recovery_due(q, interval_ms);
+	if(due == UINT64_MAX) { return normal_ms; }
+	if(q->soft_defer_until_ms > now)
+	{
+		uint64_t lifetime = interval_ms > UINT64_MAX / 4 ? UINT64_MAX : interval_ms * 4;
+		uint64_t hard_due = UINT64_MAX;
+		for(size_t i = 0; i < q->capacity; ++i)
+		{
+			if(q->slots[i].state != ASTRA_SENT) { continue; }
+			uint64_t hard = q->slots[i].sent_at_ms > UINT64_MAX - lifetime ? UINT64_MAX : q->slots[i].sent_at_ms + lifetime;
+			if(hard < hard_due) { hard_due = hard; }
+		}
+		if(due <= now) { due = q->soft_defer_until_ms < hard_due ? q->soft_defer_until_ms : hard_due; }
+	}
+	uint64_t wait = due > now ? due - now : 0;
+	return wait < (uint64_t)normal_ms ? (int)wait : normal_ms;
+}
+
+static inline int astra_semantic_wait(struct astra_semantic_core *q, uint64_t now, int ready, int normal_ms)
+{
+	uint64_t wait = (uint64_t)normal_ms;
+	for(size_t i = 0; i < q->capacity; ++i)
+	{
+		struct astra_semantic_slot *s = &q->slots[i];
+		if(s->state != ASTRA_QUEUED && s->state != ASTRA_ALIAS) { continue; }
+		uint64_t deadline = s->deadline_ms > now ? s->deadline_ms - now : 0;
+		if(deadline < wait) { wait = deadline; }
+		if(s->state == ASTRA_QUEUED && ready && q->sent < 32)
+		{
+			uint64_t due = q->next_send_ms > now ? q->next_send_ms - now : 0;
+			if(due < wait) { wait = due; }
+		}
+	}
+	return (int)wait;
+}
+#endif
