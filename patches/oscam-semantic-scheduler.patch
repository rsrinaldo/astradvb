diff --git a/oscam-reader.c b/oscam-reader.c
index ee10064..0164e21 100644
--- a/oscam-reader.c
+++ b/oscam-reader.c
@@ -1,6 +1,7 @@
 #define MODULE_LOG_PREFIX "reader"
 
 #include "globals.h"
+#include "module-cacheex.h"
 #include "module-cccam.h"
 #include "module-led.h"
 #include "module-stat.h"
@@ -18,6 +19,273 @@
 #include "oscam-work.h"
 #include "reader-common.h"
 #include "oscam-config.h"
+#include "astra-semantic-scheduler.h"
+
+/* Guarded Newcamd policy, disabled unless this reader explicitly opts in.
+ * The reader worker owns metadata; GC may only detach a parent under lock.
+ * No lock is held during protocol I/O. No extra ECM copies/threads/timers. */
+struct astra_semantic_scheduler
+{
+	pthread_mutex_t lock;
+	struct astra_semantic_core core;
+	uint64_t next_report_ms, reported_revision;
+	struct astra_semantic_slot slots[];
+};
+/* GC may race reader cleanup. Publish/acquire/destroy the optional context
+ * under one lifetime lock; the owner worker never takes it while answering. */
+static pthread_mutex_t astra_scheduler_lifetime_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static uint64_t astra_semantic_now(void)
+{
+	struct timespec now;
+	if(clock_gettime(CLOCK_MONOTONIC, &now) != 0) { return 0; }
+	return (uint64_t)now.tv_sec * 1000 + (uint64_t)now.tv_nsec / 1000000;
+}
+
+/* Numeric private diagnostics only: no account names, ECM hashes, IDs or CWs.
+ * Status is bounded to once per five seconds plus explicit reset transitions. */
+static void astra_semantic_report(struct s_reader *reader, int reset)
+{
+	struct astra_semantic_scheduler *s = reader->client->astra_scheduler;
+	uint64_t now = astra_semantic_now(), oldest = 0;
+	uint32_t queued = 0, aliases = 0;
+	pthread_mutex_lock(&s->lock);
+	struct astra_semantic_core q = s->core;
+	for(size_t i = 0; i < q.capacity; ++i)
+	{
+		struct astra_semantic_slot *slot = &q.slots[i];
+		if(slot->state == ASTRA_QUEUED) { queued++; }
+		else if(slot->state == ASTRA_ALIAS) { aliases++; }
+		else if(slot->state == ASTRA_SENT && now >= slot->sent_at_ms && now - slot->sent_at_ms > oldest) { oldest = now - slot->sent_at_ms; }
+	}
+	uint64_t revision = q.dispatched + q.coalesced + q.matched + q.expired + q.rejected + q.resets + q.closes;
+	if(!reset && (now < s->next_report_ms || (!q.sent && !queued && !aliases && revision == s->reported_revision)))
+		{ pthread_mutex_unlock(&s->lock); return; }
+	s->next_report_ms = now + 5000;
+	s->reported_revision = revision;
+	pthread_mutex_unlock(&s->lock);
+	uint32_t port = (!strcmp(reader->device, "127.0.0.1") || !strcmp(reader->device, "::1")) ? (uint32_t)reader->r_port : 0;
+	rdr_log(reader, "astra semantic %s: port=%u generation=%"PRIu64" queued=%u aliases=%u sent=%u peak=%u dispatched=%"PRIu64" matched=%"PRIu64" coalesced=%"PRIu64" expired=%"PRIu64" rejected=%"PRIu64" resets=%"PRIu64" abandoned=%"PRIu64" closes=%"PRIu64" oldestMs=%"PRIu64" resetReason=%u",
+		reset ? "reset" : "status", port, q.generation, queued, aliases, q.sent, q.peak_sent, q.dispatched, q.matched, q.coalesced, q.expired, q.rejected, q.resets, q.abandoned, q.closes, oldest, (unsigned)q.last_reset_reason);
+}
+
+void astra_semantic_reply_progress(struct s_reader *reader, int slot, uint16_t id)
+{
+	if(!reader || !reader->client || !reader->client->astra_scheduler || slot < 0) { return; }
+	struct astra_semantic_scheduler *s = reader->client->astra_scheduler;
+	pthread_mutex_lock(&s->lock);
+	astra_semantic_note_reply(&s->core, (size_t)slot, id, astra_semantic_now());
+	pthread_mutex_unlock(&s->lock);
+}
+
+void astra_semantic_destroy(struct s_client *cl)
+{
+	pthread_mutex_lock(&astra_scheduler_lifetime_lock);
+	struct astra_semantic_scheduler *s = cl->astra_scheduler;
+	if(!s) { pthread_mutex_unlock(&astra_scheduler_lifetime_lock); return; }
+	cl->astra_scheduler = NULL;
+	pthread_mutex_lock(&s->lock);
+	pthread_mutex_unlock(&s->lock);
+	pthread_mutex_destroy(&s->lock);
+	add_garbage(s);
+	pthread_mutex_unlock(&astra_scheduler_lifetime_lock);
+}
+
+int astra_semantic_detach_parent(struct s_client *cl, ECM_REQUEST *parent)
+{
+	pthread_mutex_lock(&astra_scheduler_lifetime_lock);
+	struct astra_semantic_scheduler *s = cl->astra_scheduler;
+	if(!s) { pthread_mutex_unlock(&astra_scheduler_lifetime_lock); return 0; }
+	pthread_mutex_lock(&s->lock);
+	pthread_mutex_unlock(&astra_scheduler_lifetime_lock);
+	for(size_t i = 0; i < s->core.capacity; ++i)
+	{
+		if(cl->ecmtask[i].parent == parent)
+		{
+			cl->ecmtask[i].parent = NULL;
+			cl->ecmtask[i].client = NULL;
+			cacheex_set_csp_lastnode(&cl->ecmtask[i]);
+		}
+	}
+	pthread_mutex_unlock(&s->lock);
+	return 1;
+}
+
+static int astra_semantic_enqueue_ecm(struct s_reader *reader, ECM_REQUEST *er)
+{
+	struct s_client *cl = reader->client;
+	struct astra_semantic_scheduler *s = cl->astra_scheduler;
+	struct timeb wall;
+	cs_ftime(&wall);
+	int64_t remaining = (int64_t)cfg.ctimeout - comp_timeb(&wall, &er->tps);
+	if(remaining > cfg.ctimeout) { remaining = cfg.ctimeout; }
+	uint64_t now = astra_semantic_now();
+	int alias = 0, n = -1;
+	pthread_mutex_lock(&s->lock);
+	for(size_t i = 0; i < s->core.capacity; ++i)
+	{
+		if(s->core.slots[i].state != ASTRA_EMPTY && cl->ecmtask[i].caid == er->caid &&
+			!memcmp(cl->ecmtask[i].ecmd5, er->ecmd5, CS_ECMSTORESIZE)) { alias = 1; break; }
+	}
+	if(remaining > 0)
+	{
+		uint64_t service = ((uint64_t)er->caid << 40) | ((uint64_t)(er->prid & 0xffffff) << 16) | er->srvid;
+		n = astra_semantic_enqueue(&s->core, now, now + (uint64_t)remaining, service, alias);
+	}
+	if(n >= 0)
+	{
+		memcpy(&cl->ecmtask[n], er, sizeof(ECM_REQUEST));
+		cl->ecmtask[n].matching_rdr = NULL;
+#ifdef CS_CACHEEX
+		cl->ecmtask[n].csp_lastnodes = NULL;
+#endif
+		cl->ecmtask[n].parent = er;
+		cl->ecmtask[n].idx = 0; /* no message ID until real dispatch */
+		cl->ecmtask[n].rc = E_NOCARD;
+	}
+	pthread_mutex_unlock(&s->lock);
+	/* Full table retains the existing original-client timeout ownership. An
+	 * immediate negative here could turn saturation into a local retry loop. */
+	if(n < 0)
+	{
+		if(remaining <= 0) { write_ecm_answer(reader, er, E_TIMEOUT, 0, NULL, NULL, 0, NULL); }
+		return -2;
+	}
+	return 0;
+}
+
+static void astra_semantic_complete(struct s_reader *reader, int idx, int rc, uint8_t *cw)
+{
+	struct s_client *cl = reader->client;
+	struct astra_semantic_scheduler *s = cl->astra_scheduler;
+	uint64_t now = astra_semantic_now();
+	pthread_mutex_lock(&s->lock);
+	uint16_t caid = cl->ecmtask[idx].caid;
+	uint8_t hash[CS_ECMSTORESIZE];
+	memcpy(hash, cl->ecmtask[idx].ecmd5, sizeof(hash));
+	for(size_t i = 0; i < s->core.capacity; ++i)
+	{
+		ECM_REQUEST *ecm = &cl->ecmtask[i];
+		if(s->core.slots[i].state == ASTRA_EMPTY || ecm->caid != caid || memcmp(ecm->ecmd5, hash, sizeof(hash))) { continue; }
+		if(ecm->parent)
+		{
+			int answer = s->core.slots[i].deadline_ms <= now ? E_TIMEOUT : rc == 2 ? E_INVALID : rc ? E_FOUND : E_NOTFOUND;
+			write_ecm_answer(reader, ecm, answer, 0, answer == E_FOUND ? cw : NULL, NULL, 0, NULL);
+		}
+		ecm->idx = 0;
+		ecm->rc = E_FOUND;
+		ecm->parent = NULL;
+		astra_semantic_release(&s->core, i);
+	}
+	cl->pending = (int)s->core.sent;
+	pthread_mutex_unlock(&s->lock);
+}
+
+void astra_semantic_tick(struct s_reader *reader)
+{
+	if(!reader || !reader->client || reader->client->kill || !reader->client->astra_scheduler) { return; }
+	struct s_client *cl = reader->client;
+	struct astra_semantic_scheduler *s = cl->astra_scheduler;
+	uint64_t now = astra_semantic_now();
+	pthread_mutex_lock(&s->lock);
+	int n;
+	while((n = astra_semantic_expired(&s->core, now)) >= 0)
+	{
+		ECM_REQUEST *ecm = &cl->ecmtask[n];
+		if(ecm->parent) { write_ecm_answer(reader, ecm, E_TIMEOUT, 0, NULL, NULL, 0, NULL); }
+		ecm->idx = 0; ecm->rc = E_FOUND; ecm->parent = NULL;
+		astra_semantic_release(&s->core, (size_t)n);
+		s->core.expired++;
+	}
+	for(size_t i = 0; i < s->core.capacity; ++i)
+	{
+		uint8_t state = s->core.slots[i].state;
+		if((state == ASTRA_QUEUED || state == ASTRA_ALIAS) && !cl->ecmtask[i].parent)
+		{
+			cl->ecmtask[i].idx = 0; cl->ecmtask[i].rc = E_FOUND;
+			astra_semantic_release(&s->core, i);
+		}
+	}
+	/* A newer caller may share a hash with a queued caller whose OWN deadline
+	 * expired. Promote the oldest live alias rather than extending the old
+	 * deadline or silently blocking fresh work behind a vanished leader. */
+	for(size_t i = 0; i < s->core.capacity; ++i)
+	{
+		if(s->core.slots[i].state != ASTRA_ALIAS) { continue; }
+		int leader = 0;
+		for(size_t j = 0; j < s->core.capacity; ++j)
+		{
+			uint8_t state = s->core.slots[j].state;
+			if((state == ASTRA_SENT || state == ASTRA_QUEUED) && cl->ecmtask[i].caid == cl->ecmtask[j].caid &&
+				!memcmp(cl->ecmtask[i].ecmd5, cl->ecmtask[j].ecmd5, CS_ECMSTORESIZE)) { leader = 1; break; }
+		}
+		if(!leader) { s->core.slots[i].state = ASTRA_QUEUED; }
+	}
+	/* Ready replies have priority over soft retirement as well as dispatch. */
+	struct pollfd fd = { .fd = cl->pfd, .events = POLLIN | POLLPRI };
+	int readable = cl->pfd > 0 && poll(&fd, 1, 0) > 0;
+	int reset_reason = reader->tcp_connected == 2 ? astra_semantic_recovery_decision(&s->core, now, (uint64_t)cfg.ctimeout, readable) : 0;
+	if(reset_reason)
+	{
+		s->core.resets++;
+		s->core.last_reset_reason = (uint8_t)reset_reason;
+		pthread_mutex_unlock(&s->lock);
+		/* This existing close path takes s->lock. Never call it while locked.
+		 * It retires every old ID, clears generation progress and does NOT replay
+		 * queued/sent work. A normal idle job reconnects through the account guard
+		 * and its durable rolling connection budget; no new timer/thread. */
+		network_tcp_connection_close(reader, "semantic ECM response deadline");
+		astra_semantic_report(reader, 1);
+		if(!cl->kill) { add_job(cl, ACTION_READER_IDLE, NULL, 0); }
+		return;
+	}
+	n = astra_semantic_pick(&s->core, now, reader->tcp_connected == 2 && !readable);
+	if(n >= 0)
+	{
+		uint16_t id = astra_semantic_next_id(&s->core, cl->ncd_msgid);
+		if(!id) { n = -1; }
+		else
+		{
+			/* network_message_send increments ncd_msgid before encoding. */
+			cl->ncd_msgid = (uint16_t)(id - 1);
+			cl->ecmtask[n].idx = id;
+			astra_semantic_dispatch(&s->core, (size_t)n, now, id);
+			cl->pending = (int)s->core.sent;
+		}
+	}
+	pthread_mutex_unlock(&s->lock);
+	if(n >= 0)
+	{
+		int rc = reader->ph.c_send_ecm(cl, &cl->ecmtask[n]);
+		if(rc != 0) { casc_check_dcw(reader, n, 0, cl->ecmtask[n].cw); }
+		else { cl->last_idx = cl->ecmtask[n].idx; }
+		reader->last_s = time(NULL);
+	}
+	astra_semantic_report(reader, 0);
+}
+
+int astra_semantic_poll_ms(struct s_reader *reader, int normal_ms)
+{
+	if(!reader || !reader->client || !reader->client->astra_scheduler) { return normal_ms; }
+	struct astra_semantic_scheduler *s = reader->client->astra_scheduler;
+	pthread_mutex_lock(&s->lock);
+	uint64_t now = astra_semantic_now();
+	int wait = astra_semantic_wait(&s->core, now, reader->tcp_connected == 2, normal_ms);
+	if(reader->tcp_connected == 2) { wait = astra_semantic_recovery_wait(&s->core, now, (uint64_t)cfg.ctimeout, wait); }
+	pthread_mutex_unlock(&s->lock);
+	return wait;
+}
+
+int astra_semantic_remote_priority(struct s_reader *reader)
+{
+	if(!reader || !reader->client || !reader->client->astra_scheduler || reader->tcp_connected != 2) { return 0; }
+	struct astra_semantic_scheduler *s = reader->client->astra_scheduler;
+	pthread_mutex_lock(&s->lock);
+	uint64_t due = astra_semantic_recovery_due(&s->core, (uint64_t)cfg.ctimeout);
+	int priority = due != UINT64_MAX && due <= astra_semantic_now();
+	pthread_mutex_unlock(&s->lock);
+	return priority;
+}
 
