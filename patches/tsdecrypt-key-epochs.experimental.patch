+void csa_decrypt_single_packet_with_cw(csakey_t *csakey, uint8_t *packet, const uint8_t cw[8]) {
+	struct csakey *key = (struct csakey *)csakey;
+	unsigned int parity = ts_packet_get_scrambled(packet) - 2;
+	pthread_mutex_lock(&key->lock);
+	if (parity == 0) csa_set_even_cw_unlocked(csakey, cw); else csa_set_odd_cw_unlocked(csakey, cw);
+	if (use_dvbcsa) {
+		unsigned int offset = ts_packet_get_payload_offset(packet);
+		ts_packet_set_not_scrambled(packet);
+		dvbcsa_decrypt(key->s_csakey[parity], packet + offset, 188 - offset);
+	}
+	if (use_ffdecsa) { uint8_t *cluster[3] = {packet, packet + 188, NULL}; ffdecsa_decrypt_packets(key->ff_csakey, cluster); }
+	pthread_mutex_unlock(&key->lock);
+}
+void csa_decrypt_multiple_even_with_cw(csakey_t *csakey, struct csa_batch *batch, const uint8_t cw[8]) {
