+	csa_set_even_cw_unlocked(csakey, cw); dvbcsa_bs_decrypt(key->bs_csakey[0], (struct dvbcsa_bs_batch_s *)batch, 184);
+	pthread_mutex_unlock(&key->lock);
+}
+void csa_decrypt_multiple_odd_with_cw(csakey_t *csakey, struct csa_batch *batch, const uint8_t cw[8]) {
+	struct csakey *key = (struct csakey *)csakey; pthread_mutex_lock(&key->lock);
+	csa_set_odd_cw_unlocked(csakey, cw); dvbcsa_bs_decrypt(key->bs_csakey[1], (struct dvbcsa_bs_batch_s *)batch, 184);
+	pthread_mutex_unlock(&key->lock);
+}
+void csa_decrypt_multiple_ff_with_cw(csakey_t *csakey, uint8_t **cluster, unsigned int parity, const uint8_t cw[8]) {
+	struct csakey *key = (struct csakey *)csakey; pthread_mutex_lock(&key->lock);
+	if (parity == 0) csa_set_even_cw_unlocked(csakey, cw); else csa_set_odd_cw_unlocked(csakey, cw);
+	ffdecsa_decrypt_packets(key->ff_csakey, cluster); pthread_mutex_unlock(&key->lock);
+}
