diff --git a/astra-key-epochs.h b/astra-key-epochs.h
new file mode 100644
index 0000000..5d38f4c
--- /dev/null
+++ b/astra-key-epochs.h
@@ -0,0 +1,134 @@
+/* AstraDVB, GPL-2.0-only. Input-ordered, bounded ownership of CSA key epochs.
+ * Contract: changed keys are announced by changed ECM content before use,
+ * and matching provider replies contain the correct words. An acknowledged
+ * unchanged full pair may be reused while no newer ECM identity exists.
+ * This cannot detect an omitted entire ECM epoch or authenticate a wrong CW.
+ */
+#ifndef ASTRA_KEY_EPOCHS_H
+#define ASTRA_KEY_EPOCHS_H
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ASTRA_EPOCH_PIDS 8192
+#define ASTRA_EPOCH_ECM_BYTES 400
+static inline int astra_epoch_ecm_equal(const uint8_t *first, unsigned int first_length, const uint8_t *second, unsigned int second_length) {
+    return first_length == second_length && (!first_length || memcmp(first, second, first_length) == 0);
+}
+struct astra_key_epoch {
+    uint64_t generation;
+    unsigned int refs;
+    uint8_t ready, conflicted, cw[16];
+    struct astra_key_epoch *next;
+};
+struct astra_key_epochs {
+    pthread_mutex_t lock;
+    struct astra_key_epoch *pool, *free, *latest, *table[2], *active[ASTRA_EPOCH_PIDS];
+    uint64_t last_bound[ASTRA_EPOCH_PIDS][2], generation;
+    uint8_t active_parity[ASTRA_EPOCH_PIDS], last_ecm[2][ASTRA_EPOCH_ECM_BYTES];
+    unsigned int last_length[2], capacity, used, peak;
+    uint16_t caid, service_id, ecm_pid;
+    uint64_t exhausted, unavailable, conflicts;
+};
+static inline void astra_epoch_unref_locked(struct astra_key_epochs *state, struct astra_key_epoch *epoch) {
+    if (!epoch) return;
+    assert(epoch->refs);
+    if (--epoch->refs == 0) { memset(epoch->cw, 0, sizeof(epoch->cw)); epoch->ready = 0; epoch->next = state->free; state->free = epoch; state->used--; }
+}
+static inline int astra_epochs_init(struct astra_key_epochs *state, unsigned int capacity) {
+    memset(state, 0, sizeof(*state));
+    if (!capacity || pthread_mutex_init(&state->lock, NULL) != 0) return 0;
+    state->pool = calloc(capacity, sizeof(*state->pool));
+    if (!state->pool) { pthread_mutex_destroy(&state->lock); return 0; }
+    state->capacity = capacity; memset(state->active_parity, 0xff, sizeof(state->active_parity));
+    for (unsigned int i = 0; i < capacity; i++) { state->pool[i].next = state->free; state->free = &state->pool[i]; }
+    return 1;
+}
+static inline void astra_epochs_reset_locked(struct astra_key_epochs *state) {
+    for (unsigned int pid = 0; pid < ASTRA_EPOCH_PIDS; pid++) { astra_epoch_unref_locked(state, state->active[pid]); state->active[pid] = NULL; }
+    for (unsigned int table = 0; table < 2; table++) { astra_epoch_unref_locked(state, state->table[table]); state->table[table] = NULL; state->last_length[table] = 0; }
+    state->latest = NULL;
+    memset(state->last_bound, 0, sizeof(state->last_bound)); memset(state->active_parity, 0xff, sizeof(state->active_parity));
+}
+static inline void astra_epochs_destroy(struct astra_key_epochs *state) {
+    /* All worker threads are joined before data_free. Outstanding input-delay
+     * records can be discarded here without touching their borrowed pointers. */
+    free(state->pool); state->pool = NULL; pthread_mutex_destroy(&state->lock);
+}
+static inline void astra_epochs_context(struct astra_key_epochs *state, uint16_t caid, uint16_t service_id, uint16_t ecm_pid) {
+    pthread_mutex_lock(&state->lock);
+    if (state->caid != caid || state->service_id != service_id || state->ecm_pid != ecm_pid) {
+        astra_epochs_reset_locked(state); state->caid = caid; state->service_id = service_id; state->ecm_pid = ecm_pid;
+    }
+    pthread_mutex_unlock(&state->lock);
+}
+static inline void astra_epoch_release(struct astra_key_epochs *state, struct astra_key_epoch *epoch) {
+    if (!epoch) return;
+    pthread_mutex_lock(&state->lock); astra_epoch_unref_locked(state, epoch); pthread_mutex_unlock(&state->lock);
+}
+/* Called at complete ECM input order, before the matching TS packet is queued.
+ * The returned reference belongs to the caller/request, including retries. */
+static inline struct astra_key_epoch *astra_epoch_observe(struct astra_key_epochs *state, uint16_t caid, uint16_t service_id, uint16_t ecm_pid, const uint8_t *ecm, unsigned int length) {
+    if (length < 3 || length > ASTRA_EPOCH_ECM_BYTES || (ecm[0] != 0x80 && ecm[0] != 0x81)) return NULL;
+    /* Table IDs are identity-cache slots only, never CSA key parity. */
+    unsigned int table = ecm[0] & 1; pthread_mutex_lock(&state->lock);
+    if (state->caid != caid || state->service_id != service_id || state->ecm_pid != ecm_pid) {
+        astra_epochs_reset_locked(state); state->caid = caid; state->service_id = service_id; state->ecm_pid = ecm_pid;
+    }
+    struct astra_key_epoch *epoch = state->table[table];
+    if (!epoch || !astra_epoch_ecm_equal(state->last_ecm[table], state->last_length[table], ecm, length)) {
+        epoch = state->free;
+        if (!epoch) { state->exhausted++; state->latest = NULL; pthread_mutex_unlock(&state->lock); return NULL; }
+        state->free = epoch->next; memset(epoch, 0, sizeof(*epoch)); epoch->generation = ++state->generation; epoch->refs = 1;
+        state->used++; if (state->used > state->peak) state->peak = state->used;
+        astra_epoch_unref_locked(state, state->table[table]); state->table[table] = epoch; state->latest = epoch;
+        memcpy(state->last_ecm[table], ecm, length); state->last_length[table] = length;
+    }
+    epoch->refs++; pthread_mutex_unlock(&state->lock); return epoch;
+}
+/* Per-PID parity history prevents a prefetched future same-parity ECM from
+ * changing packets still using the previous rotation. The returned packet ref
+ * remains pinned through decode, ring wrap, backpressure and EOF draining. */
+static inline struct astra_key_epoch *astra_epoch_packet(struct astra_key_epochs *state, uint16_t pid, unsigned int parity) {
+    if (pid >= ASTRA_EPOCH_PIDS || parity > 1) return NULL;
+    pthread_mutex_lock(&state->lock);
+    if (state->active_parity[pid] != parity) {
+        astra_epoch_unref_locked(state, state->active[pid]); state->active[pid] = NULL; state->active_parity[pid] = parity;
+    }
+    struct astra_key_epoch *epoch = state->active[pid], *latest = state->latest;
+    unsigned int bit = 1u << parity;
+    int reuse = latest && latest->generation == state->last_bound[pid][parity] &&
+        (latest->ready & bit) && !(latest->conflicted & bit);
+    if (!epoch && latest && (latest->generation > state->last_bound[pid][parity] || reuse)) {
+        epoch = state->active[pid] = latest; epoch->refs++; state->last_bound[pid][parity] = epoch->generation;
+    }
+    if (epoch) epoch->refs++; else state->unavailable++;
+    pthread_mutex_unlock(&state->lock); return epoch;
+}
+/* Preserve both independently positioned words. ECM table ID does not select
+ * CSA parity. A zero half remains unavailable, never inherited blindly. */
+static inline void astra_epoch_publish(struct astra_key_epochs *state, struct astra_key_epoch *epoch, const uint8_t pair[16]) {
+    static const uint8_t zero[8] = {0}; if (!epoch) return;
+    pthread_mutex_lock(&state->lock);
+    for (unsigned int parity = 0; parity < 2; parity++) if (memcmp(pair + parity * 8, zero, 8)) {
+        unsigned int bit = 1u << parity;
+        if (epoch->conflicted & bit) continue;
+        if ((epoch->ready & bit) && memcmp(epoch->cw + parity * 8, pair + parity * 8, 8)) {
+            /* Conflicting replies cannot mutate a schedule already pinned by
+             * older packets. Withhold this ambiguous half, not future ECMs. */
+            epoch->conflicted |= bit; epoch->ready &= ~bit; state->conflicts++; continue;
+        }
+        if (!(epoch->ready & bit)) memcpy(epoch->cw + parity * 8, pair + parity * 8, 8);
+        epoch->ready |= bit;
+    }
+    pthread_mutex_unlock(&state->lock);
+}
+static inline int astra_epoch_word(struct astra_key_epochs *state, struct astra_key_epoch *epoch, unsigned int parity, uint8_t word[8]) {
+    if (!epoch) return 0;
+    pthread_mutex_lock(&state->lock); int ready = parity < 2 && (epoch->ready & (1u << parity));
+    if (ready) memcpy(word, epoch->cw + parity * 8, 8); else state->unavailable++;
+    pthread_mutex_unlock(&state->lock); return ready;
+}
+#endif
